<% const chartMax=Math.max(1,...months.flatMap(m=>[Number(m.income),Number(m.expense)])); %>
<% if(months.length){ %><svg class="month-chart" viewBox="0 0 600 240" role="img" aria-label="Biểu đồ thu nhập và chi tiêu theo tháng"><% for(let i=0;i<4;i++){const y=25+i*50; %><line class="gridline" x1="55" y1="<%= y %>" x2="590" y2="<%= y %>"/><text class="axis-label" x="45" y="<%= y+4 %>" text-anchor="end"><%= ((chartMax*(3-i)/3)/1000000).toLocaleString('vi-VN',{maximumFractionDigits:1}) %>tr</text><% } const n=months.length,slot=510/n,bw=Math.min(26,slot*.25);for(let i=0;i<n;i++){const m=months[i],x=65+i*slot+slot/2,hi=Number(m.income)/chartMax*150,he=Number(m.expense)/chartMax*150; %><rect class="bar-income" x="<%= x-bw-3 %>" y="<%= 175-hi %>" width="<%= bw %>" height="<%= hi %>" rx="5"/><rect class="bar-expense" x="<%= x+3 %>" y="<%= 175-he %>" width="<%= bw %>" height="<%= he %>" rx="5"/><text class="axis-label" x="<%= x %>" y="205" text-anchor="middle">T<%= m.month.slice(5) %>/<%= m.month.slice(2,4) %></text><% } %></svg><% }else{ %><div class="empty">Chưa có giao dịch trong khoảng thời gian này.</div><% } %>
