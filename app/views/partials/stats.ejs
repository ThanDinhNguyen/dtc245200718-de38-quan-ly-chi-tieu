<section class="stats-grid" aria-label="Tổng hợp thu chi"><div class="stat-card balance"><div class="stat-label">Chênh lệch thu chi <span class="stat-icon"><%- icon('wallet') %></span></div><strong class="stat-value"><%= money(totals.balance) %></strong><span class="stat-foot">Thu nhập trừ chi tiêu trong kỳ</span><div class="balance-art" aria-hidden="true"></div></div><div class="stat-card"><div class="stat-label">Tổng thu nhập <span class="stat-icon income"><%- icon('down') %></span></div><strong class="stat-value"><%= money(totals.income) %></strong><span class="stat-foot"><span class="dot green"></span>Dòng tiền vào</span></div><div class="stat-card"><div class="stat-label">Tổng chi tiêu <span class="stat-icon expense"><%- icon('up') %></span></div><strong class="stat-value"><%= money(totals.expense) %></strong><span class="stat-foot"><span class="dot orange"></span>Dòng tiền ra</span></div><div class="stat-card"><div class="stat-label">Số giao dịch <span class="stat-icon neutral"><%- icon('arrows') %></span></div><strong class="stat-value"><%= totals.count %><span class="unit"> giao dịch</span></strong><span class="stat-foot">Đã được ghi nhận trong kỳ</span></div></section>
