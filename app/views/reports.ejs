<%- include('partials/header') %><%- include('partials/heading',{eyebrow:'NHÌN RÕ THÓI QUEN TÀI CHÍNH',heading:'Những con số biết kể chuyện.',subtitle:'Đối chiếu thu chi theo thời gian để lên kế hoạch phù hợp hơn.'}) %><form class="report-filter panel" method="get"><label>Từ ngày<input type="date" name="from" required value="<%= f.from %>" min="2000-01-01" max="2100-12-31"></label><label>Đến ngày<input type="date" name="to" required value="<%= f.to %>" min="2000-01-01" max="2100-12-31"></label><button class="button primary"><%- icon('chart') %> Xem báo cáo</button><a class="text-link" href="/reports">Tháng hiện tại</a></form><%- include('partials/stats') %><section class="chart-grid"><div class="panel"><div class="panel-heading"><div><h2>Thu chi qua từng tháng</h2><p>Tổng hợp trong khoảng ngày đã chọn</p></div><div class="chart-legend"><span><i class="dot green"></i>Thu</span><span><i class="dot orange"></i>Chi</span></div></div><%- include('partials/month-chart') %></div><div class="panel"><div class="panel-heading"><div><h2>Cơ cấu chi tiêu</h2><p>Tỷ trọng theo danh mục</p></div></div><%- include('partials/breakdown') %></div></section><section class="panel"><div class="panel-heading"><div><h2>Chi tiết theo danh mục</h2><p>Giá trị VND chính xác từ các giao dịch đã ghi</p></div></div><div class="table-scroll"><table><thead><tr><th>Danh mục</th><th>Loại</th><th>Số giao dịch</th><th class="text-right">Tổng số tiền</th></tr></thead><tbody><% if(!groups.length){ %><tr><td colspan="4"><div class="empty">Chưa có dữ liệu trong kỳ.</div></td></tr><% }for(const g of groups){ %><tr><td><strong><%= g.name %></strong></td><td><span class="type-badge <%= g.type %>"><%= labels[g.type] %></span></td><td><%= g.count %></td><td class="text-right amount <%= g.type %>"><%= money(g.amount) %></td></tr><% } %></tbody></table></div></section><%- include('partials/footer') %>
