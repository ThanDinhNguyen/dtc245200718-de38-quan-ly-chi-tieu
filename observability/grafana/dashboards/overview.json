      "type": "logs",
      "title": "Log truy cập Nginx",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "nguyen-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"de38nguyen\",job=\"nginx\"} | json"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
