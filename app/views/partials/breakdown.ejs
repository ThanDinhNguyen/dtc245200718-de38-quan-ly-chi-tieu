<% const expenseGroups=groups.filter(g=>g.type==='expense'),sum=Number(totals.expense)||1,colors=['a','b','c','d','e','f'];let offset=0; %><div class="breakdown-body"><div class="donut-wrap"><svg viewBox="0 0 180 180" role="img" aria-label="Tỷ trọng chi tiêu theo danh mục"><circle class="donut-bg" cx="90" cy="90" r="65" fill="none" stroke-width="19"/><% expenseGroups.forEach((g,i)=>{const len=Number(g.amount)/sum*408.407; %><circle class="donut-segment color-<%= colors[i%6] %>" cx="90" cy="90" r="65" fill="none" stroke-width="19" stroke-dasharray="<%= len %> <%= 408.407-len %>" stroke-dashoffset="<%= -offset %>" transform="rotate(-90 90 90)"/><% offset+=len;}); %><text class="donut-top" x="90" y="85" text-anchor="middle">TỔNG CHI</text><text class="donut-center" x="90" y="107" text-anchor="middle"><%= (Number(totals.expense)/1000000).toLocaleString('vi-VN',{maximumFractionDigits:2}) %> triệu</text></svg></div><div class="breakdown-list"><% if(!expenseGroups.length){ %><p class="muted">Chưa có khoản chi.</p><% }expenseGroups.slice(0,6).forEach((g,i)=>{ %><div class="breakdown-row"><span><i class="legend-dot color-<%= colors[i%6] %>"></i><%= g.name %></span><strong><%= (Number(g.amount)/sum*100).toFixed(1) %>%</strong></div><% }); %></div></div>
