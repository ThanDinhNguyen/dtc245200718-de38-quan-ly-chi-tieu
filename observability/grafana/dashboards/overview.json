      },
      "datasource": {
        "type": "loki",
        "uid": "nguyen-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"de38nguyen\",job=\"app\"} | json | event=~\"transaction_(created|updated|deleted)\""
