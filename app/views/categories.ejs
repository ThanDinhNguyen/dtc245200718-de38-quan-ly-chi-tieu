<%- include('partials/header') %><%- include('partials/heading',{eyebrow:'SẮP XẾP DÒNG TIỀN',heading:'Danh mục của bạn.',subtitle:'Mỗi khoản thu chi đều có một vị trí rõ ràng.',action:{url:'/categories/new',text:'Thêm danh mục'}}) %><div class="category-columns"><% for(const type of ['expense','income']){ %><section class="panel"><div class="panel-heading"><div><h2><%= labels[type] %></h2><p><%= rows.filter(c=>c.type===type).length %> danh mục</p></div><span class="transaction-icon <%= type %>"><%- icon(type==='income'?'down':'up') %></span></div><% if(!rows.some(c=>c.type===type)){ %><div class="empty">Chưa có danh mục.</div><% }for(const row of rows.filter(c=>c.type===type)){ %><div class="category-item"><span class="category-mark"><%- icon('tag') %></span><div class="category-name"><strong><%= row.name %></strong><small><%= row.used %> giao dịch đã ghi nhận</small></div><a class="icon-button" title="Sửa danh mục" href="/categories/<%= row.id %>/edit"><%- icon('edit') %></a><% if(!row.used){ %><details class="delete-confirm"><summary class="icon-button" title="Xóa danh mục"><%- icon('trash') %></summary><div class="confirm-popover"><p>Xóa danh mục này?</p><form method="post" action="/categories/<%= row.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="button danger small">Xác nhận xóa</button></form></div></details><% } %></div><% } %></section><% } %></div><p class="muted fine-print">Danh mục có giao dịch được giữ lại để bảo toàn dữ liệu. Có thể sửa tên; chỉ đổi loại hoặc xóa khi chưa có giao dịch.</p><%- include('partials/footer') %>
