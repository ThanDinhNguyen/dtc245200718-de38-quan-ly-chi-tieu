<%- include('partials/header') %><%- include('partials/heading',{eyebrow:'NHẬT KÝ THU CHI',heading:'Mọi giao dịch, một nơi.',subtitle:'Tìm lại, cập nhật và theo dõi những khoản thu chi của bạn.',action:{url:'/transactions/new',text:'Thêm giao dịch'}}) %><section class="panel"><form class="filter-grid" method="get"><label class="search-field">Tìm giao dịch<input name="q" placeholder="Nội dung hoặc danh mục…" value="<%= f.q %>" maxlength="100"></label><label>Loại<select name="type"><option value="">Tất cả thu / chi</option><option value="income" <%= f.type==='income'?'selected':'' %>>Thu nhập</option><option value="expense" <%= f.type==='expense'?'selected':'' %>>Chi tiêu</option></select></label><label>Danh mục<select name="category"><option value="">Tất cả danh mục</option><% for(const c of categories){ %><option value="<%= c.id %>" <%= f.category===String(c.id)?'selected':'' %>><%= labels[c.type] %> · <%= c.name %></option><% } %></select></label><label>Từ ngày<input type="date" name="from" value="<%= f.from %>" min="2000-01-01" max="2100-12-31"></label><label>Đến ngày<input type="date" name="to" value="<%= f.to %>" min="2000-01-01" max="2100-12-31"></label><button class="button primary filter-button"><%- icon('search') %> Lọc</button></form><div class="list-meta"><span><strong><%= total %></strong> giao dịch phù hợp</span><a class="text-link" href="/transactions">Xóa bộ lọc</a></div><%- include('partials/transaction-table') %><div class="pagination"><span>Trang <%= f.page %> / <%= pages %></span><div><% if(f.page>1){ %><a class="button secondary small" href="?<%= query(f,{page:f.page-1}) %>">Trang trước</a><% }if(f.page<pages){ %><a class="button secondary small" href="?<%= query(f,{page:f.page+1}) %>">Trang sau <%- icon('chevron') %></a><% } %></div></div></section><%- include('partials/footer') %>
