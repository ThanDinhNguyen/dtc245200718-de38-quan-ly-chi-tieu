<div class="table-scroll"><table><thead><tr><th>Giao dịch / Nội dung</th><th>Danh mục</th><th>Ngày</th><th class="text-right">Số tiền</th><th class="text-right">Thao tác</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="5"><div class="empty">Chưa có giao dịch phù hợp. Hãy thêm giao dịch hoặc thay đổi bộ lọc.</div></td></tr><% }for(const row of rows){ %><tr><td><div class="transaction-title"><span class="transaction-icon <%= row.type %>"><%- icon(row.type==='income'?'down':'up') %></span><div><strong><%= row.note||labels[row.type] %></strong><small><%= labels[row.type] %> <span>·</span> #<%= row.id %></small></div></div></td><td><span class="category-badge"><%= row.category %></span></td><td class="muted nowrap"><%= date(row.occurred_on) %></td><td class="text-right nowrap amount <%= row.type %>"><%= row.type==='income'?'+':'−' %><%= money(row.amount_vnd) %></td><td><div class="row-actions"><a class="icon-button" title="Sửa giao dịch" aria-label="Sửa giao dịch #<%= row.id %>" href="/transactions/<%= row.id %>/edit"><%- icon('edit') %></a><details class="delete-confirm"><summary class="icon-button" title="Xóa giao dịch" aria-label="Xóa giao dịch #<%= row.id %>"><%- icon('trash') %></summary><div class="confirm-popover"><p>Xóa giao dịch này?</p><form action="/transactions/<%= row.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= row.version %>"><button class="button danger small">Xác nhận xóa</button></form></div></details></div></td></tr><% } %></tbody></table></div>
