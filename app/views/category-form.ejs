<%- include('partials/header') %><%- include('partials/heading',{eyebrow:'DANH MỤC THU CHI',heading:title,subtitle:'Đặt tên ngắn gọn để dễ nhận biết trong giao dịch và báo cáo.'}) %><section class="panel form-panel compact"><form method="post" action="/categories<%= record.id?'/'+record.id:'' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(record.id){ %><input type="hidden" name="version" value="<%= record.version %>"><% } %><label>Tên danh mục<input name="name" maxlength="80" required value="<%= record.name||'' %>" placeholder="Ví dụ: Ăn uống, Tiền thưởng…"></label><label>Loại<select name="type"><option value="expense" <%= record.type==='expense'?'selected':'' %>>Chi tiêu</option><option value="income" <%= record.type==='income'?'selected':'' %>>Thu nhập</option></select></label><div class="form-actions"><a class="button secondary" href="/categories">Quay lại</a><button class="button primary">Lưu danh mục</button></div></form></section><%- include('partials/footer') %>
