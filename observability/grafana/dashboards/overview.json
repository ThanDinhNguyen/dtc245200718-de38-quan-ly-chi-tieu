      "datasource": {
        "type": "loki",
        "uid": "nguyen-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"de38nguyen\",job=\"app\"} | json | event=\"login_failed\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Log thay đổi giao dịch",
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
